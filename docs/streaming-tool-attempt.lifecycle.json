  "cards": [
    {
      "dot": "emerald",
      "title": "Normal path",
      "items": [
        "Fresh reducer state is scoped to one provider reaction",
        "Output and Commit remain globally ordered until publication",
        "Published or no-op barriers confirm every Live receipt before Settled"
      ]
    },
    {
      "dot": "amber",
      "title": "Rejected model output",
      "items": [
        "Normal EOF and final validation choose Accept or Reject",
        "Reject rolls back Live before exposing retry feedback",
        "The rejection action queues a later reaction only after reconciliation"
      ]
    },
    {
      "dot": "rose",
      "title": "Fault and recovery",
      "items": [
        "A supervisor owns side effects after the react waiter is dropped",
        "Uncertain apply, settlement, or publish retains prepared operations",
        "Cleanup state and the saved business disposition remain independent"
      ]
