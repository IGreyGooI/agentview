{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Chess 回合：准备到下一轮",
    "output": "docs/chess-loop.workflow.html",
    "viewBox": [720, 390],
    "quality_profile": "showcase",
    "legend": { "mode": "hidden" }
  },
  "lanes": [
    { "id": "drive", "label": "驱动、准备与模型回合" },
    { "id": "settle", "label": "XML 完成、归约与下一轮" }
  ],
  "phases": [
    { "id": "prepare", "label": "准备屏障", "fromCol": 0, "toCol": 1 },
    { "id": "reaction", "label": "模型回合", "fromCol": 3, "toCol": 5, "variant": "emphasis" }
  ],
  "mainPath": ["prepare", "actor-prep", "request-barrier", "model-react"],
  "nodes": [
    { "id": "prepare", "lane": "drive", "col": 0, "type": "frontend", "label": "显式准备", "sublabel": "prepare()", "width": 92 },
    { "id": "actor-prep", "lane": "drive", "col": 1, "type": "messagebus", "label": "Actor 准备", "sublabel": "Start / 条件搜索", "width": 92 },
    { "id": "request-barrier", "lane": "drive", "col": 3, "type": "messagebus", "label": "请求与放行", "sublabel": "组件 request()", "width": 92 },
    { "id": "model-react", "lane": "drive", "col": 5, "type": "cloud", "label": "模型回合", "sublabel": "react() 内先准备", "width": 92 },
    { "id": "xml-finish", "lane": "settle", "col": 5, "type": "security", "label": "XML 完成", "sublabel": "流式增量 + EOF", "width": 92 },
    { "id": "reduce", "lane": "settle", "col": 3, "type": "database", "label": "同步归约", "sublabel": "接受或拒绝", "width": 92 },
    { "id": "stream-settle", "lane": "settle", "col": 1, "type": "backend", "label": "流式结算", "sublabel": "清理完成", "width": 92 },
    { "id": "next-drive", "lane": "settle", "col": 0, "type": "frontend", "label": "下一轮驱动", "sublabel": "再次 prepare", "width": 92 }
  ],
  "edges": [
    { "id": "prepare-actor", "from": "prepare", "to": "actor-prep", "role": "main" },
    { "id": "actor-request", "from": "actor-prep", "to": "request-barrier", "role": "main", "variant": "emphasis" },
    { "id": "request-react", "from": "request-barrier", "to": "model-react", "role": "main", "variant": "emphasis" },
    { "id": "reaction-finish", "from": "model-react", "to": "xml-finish", "role": "return", "variant": "emphasis" },
    { "id": "finish-reduce", "from": "xml-finish", "to": "reduce", "role": "return", "variant": "emphasis" },
    { "id": "reduce-settle", "from": "reduce", "to": "stream-settle", "role": "return" },
    { "id": "settle-next", "from": "stream-settle", "to": "next-drive", "role": "return" },
    { "id": "next-prepare", "from": "next-drive", "to": "prepare", "role": "return", "variant": "emphasis", "fromSide": "left", "toSide": "left", "route": "return-left", "channelX": 18 }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "准备闸门",
      "items": [
        "Ready 执行 Start；AwaitingStockfish 搜索",
        "组件请求后，所有准备完成才可 react",
        "终局清理 UCI；驱动消费 demand 前后检查结果"
      ]
    },
    {
      "dot": "amber",
      "title": "请求去重",
      "items": [
        "requested_attempt 只为新 ModelAttemptKey 请求",
        "react 的隐式 prepare 复用同一去重",
        "prepare 本身不提交模型 Frame"
      ]
    },
    {
      "dot": "emerald",
      "title": "收敛语义",
      "items": [
        "正常 EOF 后 XML 合约完成决策",
        "Accept 发布动作，Reject 写入反馈",
        "两路都同步 reduce_signal 后结算"
      ]
    }
  ]
}
