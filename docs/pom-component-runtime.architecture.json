{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "AgentView POM Component Runtime",
    "subtitle": "Mounted System/User POM, real-time provided components, and durable publication",
    "output": "pom-component-runtime.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "mounted-system",
        "label": "One System epoch",
        "focus": ["mount-config", "system-view", "mount-compiler", "mounted-epoch", "provider-catalog"],
        "note": "One explicit mount renders System once and stores its POM, factories, contracts, and immutable provider catalog as one epoch bundle."
      },
      {
        "id": "dynamic-user",
        "label": "Dynamic User turn",
        "focus": ["turn-input", "user-view", "turn-plan", "prepare-gate"],
        "note": "User POM is application-defined and rerendered for each preparation; only the final Ready plan starts an attempt."
      },
      {
        "id": "realtime-provider",
        "label": "Real-time provider path",
        "focus": ["prepare-gate", "attempt-owner", "provider-adapter", "combined-attempt", "live-runtime", "finished-attempt"],
        "note": "Text and native tool calls enter one ordered fallible wire. Pure reducers emit typed values; Live effects are awaited before the next event."
      },
      {
        "id": "durable-publication",
        "label": "Durable publication",
        "focus": ["finished-attempt", "commit-stager", "session-mutation", "publication-owner", "publication-store"],
        "note": "Mounted owner resolves uncertainty, then writes session and receipt revision before Wait or same-epoch Continue."
      },
      {
        "id": "outbox-delivery",
        "label": "External delivery target",
        "focus": ["publication-store", "outbox-worker", "effect-receiver"],
        "note": "Published means durably queued. A future recovery worker delivers at least once by stable OutboxItemId."
      }
    ]
  },
